<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:mcp="http://www.mulesoft.org/schema/mule/mcp"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mcp http://www.mulesoft.org/schema/mule/mcp/current/mule-mcp.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <configuration-properties
        file="config.properties"
        doc:name="Configuration properties"/>

    <!-- HTTP Listener Config for MCP Streamable HTTP Transport -->
    <http:listener-config
        name="MCP_HTTP_Listener_Config"
        doc:name="MCP HTTP Listener Config"
        doc:description="Configures HTTP listener for MCP inbound traffic">
        <http:listener-connection
            host="0.0.0.0"
            port="${http.port}"/>
    </http:listener-config>

    <!-- MCP Server Configuration using Streamable HTTP -->
    <mcp:server-config
        name="MCP_Server_Config"
        doc:name="MCP Server Config"
        doc:description="MCP server configuration exposing travel agent tools via Streamable HTTP"
        serverName="${mcp.serverName}"
        serverVersion="${mcp.serverVersion}">
        <mcp:streamable-http-server-connection
            listenerConfig="MCP_HTTP_Listener_Config"
            responseContentType="JSON"/>
    </mcp:server-config>

    <!-- HTTP Request Config for Agent Broker -->
    <http:request-config
        name="agent-broker-http-config"
        doc:name="Agent Broker HTTP Config"
        doc:description="Configures outbound HTTPS requests to the Agent Broker service"
        responseTimeout="120000">
        <http:request-connection
            host="${agent.broker.host}"
            port="${agent.broker.port}"
            protocol="HTTPS"
            connectionIdleTimeout="120000"/>
    </http:request-config>

    <!-- Object Store for conversation context (contextId + taskId per Slack channel) -->
    <os:object-store
        name="conversation-context-store"
        doc:name="Conversation Context Store"
        persistent="true"
        maxEntries="100"
        entryTtl="1"
        entryTtlUnit="HOURS"/>

    <!-- HTTP Request Config for Slack API -->
    <http:request-config
        name="slack-http-config"
        doc:name="Slack API HTTP Config"
        doc:description="Configures outbound HTTPS requests to the Slack API">
        <http:request-connection
            host="slack.com"
            port="443"
            protocol="HTTPS"/>
    </http:request-config>

</mule>